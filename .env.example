# Copy this file to .env.local at the repo root (gitignored) and fill it in.
# `npm run dev:api` and `npm run auth:desknets` load .env.local automatically
# via Node's --env-file flag, so these no longer need to be re-typed as
# $env:... in every new terminal session.

# Optional Azure OpenAI Structured Outputs intent analyzer
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Agent services
AGENT_API_PORT=3001
AGENT_API_KEY=
WEB_CONSOLE_PORT=3000

# Browser safety limits
ALLOWED_DOMAINS=
DESKNETS_CDP_ENDPOINT=http://127.0.0.1:9222
DESKNETS_PARTICIPANT_ALIASES_PATH=.data/desknets-participant-aliases.json
DESKNETS_FACILITY_PREFERENCES_PATH=.data/desknets-facility-preferences.json
DESKNETS_CDP_PORT=9222
# Candidate search hours in Asia/Tokyo (HH:mm); meetings must end within this window.
DESKNETS_MEETING_START_TIME=09:00
DESKNETS_MEETING_END_TIME=17:00
MAX_AGENT_STEPS=30
MAX_RUN_DURATION_MS=300000
BROWSER_HEADLESS=true

# Meeting-room preference by DeskNet's 代表組織, and per-person exceptions.
# JSON objects. Optional — if unset, the code's own defaults apply
# (経営企画部: アクトミーティングルームC -> other アクト rooms,
# 営業統括部: 有玉). A user registration stored at the path above takes
# precedence over these organization defaults.
FACILITY_PREFERENCE_BY_ORGANIZATION=
FACILITY_PREFERENCE_OVERRIDE_BY_USER=
# Optional local AzureChat env file; reuse only its LLM settings for conversation analysis.
DESKNETS_AZURECHAT_ENV_FILE=
