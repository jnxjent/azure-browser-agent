{
  "name": "azure-browser-agent",
  "version": "1.0.0",
  "description": "Safe browser-agent proof of concept",
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --build --pretty false",
    "clean": "tsc --build --clean",
    "dev:api": "npm run dev --workspace @azure-browser-agent/agent-api",
    "dev:web": "npm run dev --workspace @azure-browser-agent/web-console",
    "test": "npm run check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
